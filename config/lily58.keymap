            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LPAR &kp DQT &kp E &kp M &kp O &kp T &kp I &kp O &kp N &kp DQT &kp COMMA &kp DQT &kp S &kp M &kp I &kp R &kp K &kp DQT &kp RPAR>;
            label = "SMIRK";
        };

        Tense: Tense {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LPAR &kp DQT &kp E &kp M &kp O &kp T &kp I &kp O &kp N &kp DQT &kp COMMA &kp DQT &kp T &kp E &kp N &kp S &kp E &kp DQT &kp RPAR>;
            label = "TENSE";
        };

        Wistful: Wistful {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LPAR &kp DQT &kp E &kp M &kp O &kp T &kp I &kp O &kp N &kp DQT &kp COMMA &kp DQT &kp W &kp I &kp S &kp T &kp F &kp U &kp L &kp DQT &kp RPAR>;
            label = "WISTFUL";
        };

        Dissoc: Dissociating {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LPAR &kp DQT &kp E &kp M &kp O &kp T &kp I &kp O &kp N &kp DQT &kp COMMA &kp DQT &kp D &kp I &kp S &kp S &kp O &kp C &kp I &kp A &kp T &kp I &kp N &kp G &kp DQT &kp RPAR>;
            label = "DISSOCIATING";
        };

        ArmsBack: ArmsBack {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp DOLLAR &kp LS(A) &kp S &kp T &kp E &kp R &kp I &kp O &kp N &kp DOT &kp A &kp R &kp M &kp S &kp LS(B) &kp A &kp C &kp K &kp LPAR &kp RPAR>;
            label = "ARMSBACK";
        };

        ArmsLoose: ArmsLoose {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp DOLLAR &kp LS(A) &kp S &kp T &kp E &kp R &kp I &kp O &kp N &kp DOT &kp A &kp R &kp M &kp S &kp LS(L) &kp O &kp O &kp S &kp E &kp LPAR &kp RPAR>;
            label = "ARMSLOOSE";
        };

        LBack: LeftBack {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LPAR &kp DQT &kp L &kp E &kp F &kp T &kp A &kp R &kp M &kp DQT &kp COMMA &kp DQT &kp B &kp A &kp C &kp K &kp DQT &kp RPAR>;
            label = "LEFTBACK";
        };

        LRelax: LeftRelaxed {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LPAR &kp DQT &kp L &kp E &kp F &kp T &kp A &kp R &kp M &kp DQT &kp COMMA &kp DQT &kp R &kp E &kp L &kp A &kp X &kp E &kp D &kp DQT &kp RPAR>;
            label = "LEFTRELAXED";
        };

        LRais: LeftRaised {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LPAR &kp DQT &kp L &kp E &kp F &kp T &kp A &kp R &kp M &kp DQT &kp COMMA &kp DQT &kp R &kp A &kp I &kp S &kp E &kp D &kp DQT &kp RPAR>;
            label = "LEFTRAISED";
        };

        RBack: RightBack {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LPAR &kp DQT &kp R &kp I &kp G &kp H &kp T &kp A &kp R &kp M &kp DQT &kp COMMA &kp DQT &kp B &kp A &kp C &kp K &kp DQT &kp RPAR>;
            label = "RIGHTBACK";
        };

        RHips: RightHips {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp LPAR &kp DQT &kp R &kp I &kp G &kp H &kp T &kp A &kp R &kp M &kp DQT &kp COMMA &kp DQT &kp H &kp I &kp P &kp S &kp DQT &kp RPAR>;
            label = "RIGHTHIPS";
        };

        LukeCh: LukeCh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp DLLR &kp LS(L) &kp U &kp K &kp E &kp DOT &kp C &kp H &kp A &kp N &kp G &kp E>;
            label = "LUKECH";
        };

        KotaCh: KotaCh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp DLLR &kp LS(K) &kp O &kp T &kp A &kp DOT &kp C &kp H &kp A &kp N &kp G &kp E>;
            label = "KOTACH";
        };

        ArgosCh: ArgosCh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp DLLR &kp LS(A) &kp R &kp G &kp O &kp S &kp DOT &kp C &kp H &kp A &kp N &kp G &kp E>;
            label = "ARGOSCH";
        };

        ThembaCh: ThembaCh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp DLLR &kp LS(T) &kp H &kp E &kp M &kp B &kp A &kp DOT &kp C &kp H &kp A &kp N &kp G &kp E>;
            label = "THEMBACH";
        };

        KhenCh: KhenCh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none &kp DLLR &kp LS(K) &kp H &kp E &kp N &kp B &kp I &kp S &kp H &kp DOT &kp C &kp H &kp A &kp N &kp G &kp E>;
            label = "KHENCH";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |   `      |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   -   |
            // |  TAB     |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   =   |
            // |hCTRL tESC|  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT    |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                        | ALT  | GUI  | LOWER|  SPACE |  | BSPC  | ENTER| RAISE | CTRL  |

            bindings = <
&kp ESCAPE    &kp N1  &kp N2  &kp N3   &kp N4  &kp N5                                                &kp N6   &kp N7           &kp N8     &kp N9   &kp N0    &kp EQUAL
&kp LEFT_ALT  &kp Q   &kp W   &kp E    &kp R   &kp T                                                 &kp Y    &kp U            &kp I      &kp O    &kp P     &kp MINUS
&kp CLCK      &kp A   &kp S   &kp D    &kp F   &kp G                                                 &kp H    &kp J            &kp K      &kp L    &kp SEMI  &kp RCTRL
&mo 4         &kp Z   &kp X   &kp C    &kp V   &kp B             &kp LEFT_SHIFT    &kp SINGLE_QUOTE  &kp N    &kp M            &kp COMMA  &kp DOT  &kp FSLH  &kp BACKSLASH
                              &kp TAB  &mo 2   &kp LEFT_CONTROL  &kp SPACE         &kp BSPC          &kp RET  &kp RIGHT_SHIFT  &mo 1
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  F12    |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |   F7  |   F8  |  F9  |  F10  |  F11  |
            // |   `     |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |   -   |
            // |CTRL/ESC |     |     |      |      |      |                   |  <-  |   ^   |   v   |  ->  |       |       |
            // | SHIFT   |     |     |      |      |      |        |  |       |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                       |      |      |      |        |  |       |      |       |       |

            bindings = <
&kp F12        &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                               &kp F6       &msc SCRL_UP    &kp PRINTSCREEN  &kp PG_UP        &kp F10   &kp F11
&kp GRAVE      &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                               &kp N6       &msc SCRL_DOWN  &msc SCRL_UP     &kp PAGE_DOWN    &kp N0    &kp MINUS
&mt LCTRL ESC  &trans  &trans  &trans  &trans  &trans                               &kp LEFT     &msc SCRL_LEFT  &msc SCRL_DOWN   &msc SCRL_RIGHT  &trans    &trans
&kp LSHIFT     &trans  &trans  &trans  &trans  &trans  &trans    &kp RIGHT_CONTROL  &kp KP_PLUS  &kp MINUS       &kp EQUAL        &kp LBKT         &kp RBKT  &kp RIGHT_SHIFT
                               &trans  &trans  &trans  &trans    &kp RIGHT_ALT      &trans       &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |          | BT1     | BT2    |  BT3 |  BT4  |  BT5 |                    |      |       |       |      |       |       |
            // |          |         |        |      |       |      |                    |      |       |       |  [   |   ]   |   \   |
            // |   ~      |  !      |  @     |  #   |  $    |  %   |                    |  ^   |  &    |  *    |  (   |   )   |   _   |
            // | SHIFT    |  EP_ON  | EP_OFF |      |  (    |  {   |       |  |   DEL   |  }   |  )    |  +    |  {   |   }   | SHIFT |
            //                               |      |       |      |       |  |         |      |       |       |

            bindings = <
&trans      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                                &trans      &msc SCRL_UP    &kp PSCRN          &kp PG_UP        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans      &trans        &trans        &trans        &trans        &trans                                      &trans      &msc SCRL_DOWN  &kp UP             &kp PAGE_DOWN    &kp LBKT              &kp RBKT
&kp TILDE   &kp EXCL      &kp AT        &kp HASH      &kp DOLLAR    &kp PRCNT                                   &trans      &kp LEFT        &kp DOWN           &kp RIGHT        &kp LEFT_BRACE        &kp RIGHT_BRACE
&kp LSHIFT  &trans        &trans        &kp LPAR      &kp LBRC      &trans        &kp LEFT_SHIFT    &kp MINUS   &kp C_PLAY  &kp C_MUTE      &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp SLASH             &kp BACKSLASH
                                        &trans        &trans        &trans        &trans            &kp DELETE  &kp ENTER   &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        AsterionExpressions {
            bindings = <
&trans  &trans           &trans    &trans        &kp DOLLAR  &TiredY                                &trans    &trans   &trans    &trans    &trans  &trans
&trans  &trans           &trans    &Embarrassed  &Relieved   &Thinking                              &Angry    &TODO    &Smile    &Annoyed  &Proud  &trans
&trans  &Asterion_Emote  &SadY     &Determined   &trans      &Angry                                 &Horny    &else    &Shocked  &trans    &trans  &trans
&trans  &trans           &Excited  &Crying       &trans      &trans     &Asterion_Emote    &Change  &Neutral  &Mooing  &trans    &trans    &trans  &trans
                                   &trans        &trans      &trans     &trans             &trans   &trans    &trans   &trans
            >;
        };

        dyel {
            bindings = <
&LRais   &trans    &trans     &trans     &trans      &trans                        &LukeCh   &KotaCh  &ArgosCh  &trans     &trans  &trans
&LRelax  &trans    &Wistful   &trans     &trans      &trans                        &trans    &TODO    &TiredY   &trans     &trans  &RHips
&LBack   &angryy   &Surprise  &Dissoc    &Flicker    &trans                        &Happy    &else    &trans    &Laughing  &trans  &RBack
&trans   &Angrier  &trans     &trans     &trans      &Bowing  &trans    &AstCh     &Tense    &trans   &trans    &trans     &trans  &trans
                              &ArmsBack  &ArmsLoose  &Smile   &SadY     &NeutralY  &Contemp  &Open    &Smirk
            >;
        };

        Chapter20Macros {
            bindings = <
&trans  &trans  &trans  &trans        &trans     &trans                            &trans    &trans        &trans     &trans         &trans          &trans
&trans  &trans  &trans  &PregnancyRP  &Romantic  &Servicetop                       &trans    &TODO         &trans     &OrgasmDenial  &ExtraPleasure  &trans
&trans  &trans  &trans  &Dominant     &trans     &Rough                            &AstCh    &else         &show      &UDGCG         &trans          &trans
&tog 0  &trans  &trans  &ExtraCum     &Vocal     &trans       &SmallPP     &Musk0  &NoTouch  &PregnancyRP  &hide      &udgPANEL      &Dissolve       &trans
                        &Bull         &Human     &BigPP       &NormalPP    &Musk1  &Musk2    &Playerkinks  &BigBalls
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        MinoHotel_Coding {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
